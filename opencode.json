{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-ninfer": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NInfer (local Qwen3.8-27B)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "ninfer"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (local, RTX 4090)",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 220000,
            "output": 8192
          }
        }
      }
    }
  }
}
