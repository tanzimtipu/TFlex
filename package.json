{
    "name":  "tflex",
    "version":  "1.7.17",
    "description":  "TFlex - desktop PDF studio for Windows",
    "repository":  "tanzimtipu/TFlex",
    "type":  "module",
    "main":  "dist/main/index.js",
    "scripts":  {
                    "dev":  "concurrently -k -n renderer,electron \"vite\" \"wait-on http://localhost:5173 \u0026\u0026 npm run build:node \u0026\u0026 electron .\"",
                    "build":  "npm run typecheck \u0026\u0026 npm run build:renderer \u0026\u0026 npm run build:node",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "build:renderer":  "vite build",
                    "build:node":  "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:tesseract.js --target=node24 --outfile=dist/main/index.js \u0026\u0026 node -e \"require(\u0027fs\u0027).writeFileSync(\u0027dist/main/package.json\u0027, JSON.stringify({type:\u0027commonjs\u0027}))\" \u0026\u0026 esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --target=node24 --outfile=dist/preload/preload.cjs",
                    "start:prod":  "electron .",
                    "dist":  "npm run build \u0026\u0026 electron-builder --publish never",
                    "test:unit":  "vitest run",
                    "test:coverage":  "vitest run --coverage",
                    "test:e2e":  "playwright test"
                },
    "dependencies":  {
                         "@fontsource-variable/inter":  "^5.2.5",
                         "electron-updater":  "^6.8.9",
                         "lucide-react":  "^1.34.0",
                         "pdf-lib":  "^1.17.1",
                         "pdfjs-dist":  "4.10.38",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8",
                         "tesseract.js":  "^7.0.0"
                     },
    "devDependencies":  {
                            "@napi-rs/canvas":  "^1.0.8",
                            "@playwright/test":  "^1.62.1",
                            "@types/node":  "^24.13.3",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.5",
                            "@vitejs/plugin-react":  "^6.1.0",
                            "@vitest/coverage-v8":  "^4.1.11",
                            "concurrently":  "^10.0.5",
                            "electron":  "^44.0.0",
                            "electron-builder":  "^26.15.3",
                            "esbuild":  "^0.28.2",
                            "jsdom":  "^30.0.1",
                            "pdfkit":  "^0.20.1",
                            "pngjs":  "^7.0.0",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.2.2",
                            "vitest":  "^4.1.11",
                            "wait-on":  "^9.1.0"
                        },
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "allowScripts":  {
                         "esbuild@0.28.2":  true,
                         "electron-winstaller@5.4.0":  true,
                         "electron@44.0.0":  true
                     }
}
