{
    "name": "tflex",
    "version": "1.40.1",
    "description": "TFlex - desktop PDF studio for Windows",
    "repository": "tanzimtipu/TFlex",
    "type": "module",
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "concurrently -k -n renderer,electron \"vite\" \"wait-on http://localhost:5173 && npm run build:node && electron .\"",
        "build": "npm run typecheck && npm run build:renderer && npm run build:node",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build:renderer": "vite build",
        "build:node": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:tesseract.js --target=node24 --outfile=dist/main/index.js && node -e \"require('fs').writeFileSync('dist/main/package.json', JSON.stringify({type:'commonjs'}))\" && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --target=node24 --outfile=dist/preload/preload.cjs",
        "start:prod": "electron .",
        "dist": "npm run build && electron-builder --publish never",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "verify": "node scripts/check-conventions.mjs && npm run typecheck",
        "verify:full": "npm run verify && npm run test:unit"
    },
    "tflex": {
        "neonAuthBaseUrl": "https://ep-fragrant-pond-b3gqd6cf.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth",
        "neonDataApiUrl": "https://ep-fragrant-pond-b3gqd6cf.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1",
        "neonFunctionApiUrl": "https://br-purple-tooth-b31y4y7b-api.compute.c-4.ap-southeast-1.aws.neon.tech/"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.5",
        "@neon/config": "^1.7.2",
        "@neon/env": "^1.4.3",
        "@neondatabase/auth": "^0.5.0-beta",
        "@neondatabase/neon-js": "^0.7.0-beta",
        "@pdf-lib/fontkit": "^1.1.1",
        "electron-updater": "^6.8.9",
        "lucide-react": "^1.34.0",
        "motion": "^13.2.0",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "4.10.38",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1141.0",
        "@aws-sdk/s3-request-presigner": "^3.1141.0",
        "@napi-rs/canvas": "^1.0.8",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "concurrently": "^10.0.5",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "jose": "^6.2.12",
        "jsdom": "^30.0.1",
        "pdfkit": "^0.20.1",
        "playwright": "^1.63.0",
        "pngjs": "^7.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "wait-on": "^9.1.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "electron-winstaller@5.4.0": true,
        "electron@44.0.0": true
    }
}
