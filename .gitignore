node_modules/
dist/
release/
*.log
.DS_Store
Thumbs.db
.vite/
coverage/

# Secrets and test evidence — never push anything that could contain credentials,
# Playwright artifacts, or local settings.
.env
test-results/
screenshots/

# qa scratch scripts — ad-hoc debug launchers, DOM dumps and button probes.
# Never committed; phase and retest specs (*.spec.cjs / *.spec.js) stay tracked.
/debug_launch.cjs
/dom.html
/e2e/debug_*.cjs
/e2e/check_data_tool.cjs
/e2e/list_buttons.cjs
# Generated e2e frame dumps - written by the committed def338 specs on every run.
# Regenerated output, never committed.
/e2e/def338-frames/

# Root-level OTA manifest strays. The legitimate latest.yml lives under release/
# (ignored above); these root-level copies are electron-builder/auto-update
# artifacts that must never be committed.
/latest.yml
/latest_gh.yml
/dev-app-update.yml
.neon

# Runtime build mutex written by agents before heavy build/test commands
# (see SHARED WORKSPACE rules). Never committed; the watchdog reaps staleness.
/.paperclip-build.lock

# Local-only P74 real-form fixture: required by e2e/phase74_real_form.spec.cjs:37,
# a byte copy of the operator's personal encrypted 956.pdf - NEVER commit it.
/test-fixtures/tfl225/

# Spent build-mutex files (watchdog reaps; never committed).
/.paperclip-build.lock.spent-*
